{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Authenticated user profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "country": { "type": "string" },
        "language": { "type": "string" },
        "timezone": { "type": "string" },
        "workStyle": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "plan": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Connection": {
      "title": "Connected Service Info",
      "description": "Metadata for external connected applications",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "connected": { "type": "boolean" },
        "connectedAt": { "type": "string" },
        "email": { "type": "string" },
        "scopes": { "type": "string" }
      },
      "required": ["uid", "provider", "connected"]
    },
    "Task": {
      "title": "Workspace Task",
      "description": "Task created by user or connected flows",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID who owns this task" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "connectorId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "status", "priority"]
    },
    "Activity": {
      "title": "Recent Activity Log",
      "description": "A lightweight log of an action performed in the workspace",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID who performed the action" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "actionType": { "type": "string" },
        "source": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "title", "actionType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user profiles collection"
    },
    "/users/{userId}/connections/{provider}": {
      "schema": "Connection",
      "description": "External integration connection entries"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Workspace tasks collection"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Workspace activity logs collection"
    }
  }
}
