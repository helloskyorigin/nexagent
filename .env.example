# NEXOrbit Environment Variable Blueprint (.env.example)
# IMPORTANT: Copy these variables into your platform/local environment settings.
# NEVER commit real private keys or secrets to source control.

# --- Firebase Web App Client Config (Public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK Credentials (Server-Only Secret) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- AI Model Key (Server-Only Secret) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Web Search Provider ---
BRAVE_SEARCH_API_KEY=

# --- Google OAuth Credentials (for Gmail / Workspace Connectors) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Security & Encryption ---
ENCRYPTION_KEY=
APP_URL=

# Cloudflare Workers AI for Image Generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
